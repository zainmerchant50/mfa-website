# Old WordPress URLs (pre-Oct 2026). Useful pages -> 301 to their new home.
/contact              /#contact        301
/contact-us           /#contact        301
/contact/*            /#contact        301
# /services/ is a real page since 2026-10-20 (services moved off the home page).
/service              /services/       301
/service/*            /services/       301
/about                /#approach       301
/about-us             /#approach       301
/about-us/*           /#approach       301
/privacy-policy       /privacy.html    301
/privacy-policy/*     /privacy.html    301
/terms-conditions     /terms.html      301
/terms-conditions/*   /terms.html      301
/terms-and-conditions /terms.html      301
/feed                 /blog/feed.xml   301
/feed/*               /blog/feed.xml   301
# (/privacy, /terms, /disclaimer need no rule: both hosts serve the .html file at the bare path,
#  and on Cloudflare a /privacy -> /privacy.html rule would loop with its .html -> bare redirect.)

# Everything else that no longer exists (old portfolio, demo pages, wp-* paths) falls through to
# /404.html with a 404 status automatically (Netlify and Cloudflare Pages both do this).
# A 410 catch-all was removed because Cloudflare Pages _redirects doesn't support status 410.
# Evergreen short links (update yearly)
/tax-calendar          /blog/2027-tax-calendar/   302
/2027-tax-calendar     /blog/2027-tax-calendar/   301

# Resources hub (site session)
/tools                 /resources/                301
/tools/                /resources/                301

# Reviews live on the home page only (Zain, 2026-10-25: no separate reviews page)
/reviews               /#reviews                  301
/reviews/              /#reviews                  301
/testimonials          /#reviews                  301
/testimonials/         /#reviews                  301
